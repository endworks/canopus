{
  "name": "@canopus/weather",
  "version": "0.1.0",
  "description": "Weather microservice — one reading per place, from whichever provider the caller has a key for",
  "author": {
    "name": "end.works",
    "email": "ender@end.works",
    "url": "https://github.com/endworks"
  },
  "homepage": "https://github.com/endworks/canopus",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/endworks/canopus.git"
  },
  "bugs": {
    "url": "https://github.com/endworks/canopus/issues"
  },
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:regions": "node scripts/build-regions.mjs",
    "client-key": "ts-node -T -P tsconfig.json scripts/client-key.ts",
    "zaragoza-air": "ts-node -T -P tsconfig.json scripts/zaragoza-air.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@canopus/nest": "workspace:*",
    "@canopus/shared": "workspace:*",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "axios": "^1.20.0",
    "cache-manager": "^7.2.9",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist"
  ]
}
